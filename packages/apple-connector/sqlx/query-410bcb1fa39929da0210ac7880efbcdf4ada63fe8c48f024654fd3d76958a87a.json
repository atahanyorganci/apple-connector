{
  "db_name": "SQLite",
  "query": "\n        SELECT\n          c.ROWID AS \"row_id!\",\n          lower(c.UUID) AS \"id!: String\",\n          c.title,\n          c.color,\n          c.store_id AS \"store_id!\",\n          lower(s.external_id) AS \"account_id!: String\",\n          c.notes,\n          c.sharing_status\n        FROM Calendar c\n        JOIN Store s ON s.ROWID = c.store_id\n        WHERE (?1 IS NULL OR c.ROWID < ?1)\n        ORDER BY c.ROWID DESC\n        LIMIT ?2\n        ",
