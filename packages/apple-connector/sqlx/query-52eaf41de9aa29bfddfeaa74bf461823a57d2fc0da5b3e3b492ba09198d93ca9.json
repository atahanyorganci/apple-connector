  "query": "\n        SELECT\n            CAST(lower(substr(r.ZUNIQUEID, 1, instr(r.ZUNIQUEID, ':') - 1)) AS TEXT) AS \"api_id: String\",\n            r.ZUNIQUEID AS \"external_id!\",\n            r.ZNAME AS name,\n            r.ZTYPE AS container_type\n        FROM ZABCDRECORD r\n        WHERE r.Z_ENT = 25\n          AND lower(substr(r.ZUNIQUEID, 1, instr(r.ZUNIQUEID, ':') - 1)) = lower(?1)\n        ",
