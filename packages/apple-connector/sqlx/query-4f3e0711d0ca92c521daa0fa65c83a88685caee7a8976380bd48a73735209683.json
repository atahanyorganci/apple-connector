  "db_name": "SQLite",
  "query": "\n        SELECT\n            CAST(lower(substr(r.ZUNIQUEID, 1, instr(r.ZUNIQUEID, ':') - 1)) AS TEXT) AS \"api_id: String\",\n            r.ZNAME AS name,\n            r.ZTYPE AS group_type,\n            r.ZCONTAINER AS container_id\n        FROM ZABCDRECORD r\n        WHERE r.Z_ENT = 19\n          AND lower(substr(r.ZUNIQUEID, 1, instr(r.ZUNIQUEID, ':') - 1)) = lower(?1)\n        ",
