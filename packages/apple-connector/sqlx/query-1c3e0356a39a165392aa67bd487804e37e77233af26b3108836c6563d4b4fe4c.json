  "query": "\n        SELECT\n          lower(c.UUID) AS \"api_id!: String\",\n          c.external_id,\n          c.title,\n          s.type AS store_type\n        FROM Calendar c\n        JOIN Store s ON s.ROWID = c.store_id\n        WHERE lower(c.UUID) = lower(?1)\n        ",
