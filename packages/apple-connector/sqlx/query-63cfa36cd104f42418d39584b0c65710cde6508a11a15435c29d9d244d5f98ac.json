  "db_name": "SQLite",
  "query": "\n        SELECT\n          af.ROWID AS \"row_id!\",\n          lower(af.UUID) AS \"id!: String\",\n          af.filename,\n          af.format,\n          af.file_size,\n          af.local_path\n        FROM Attachment a\n        JOIN AttachmentFile af ON af.ROWID = a.file_id\n        JOIN CalendarItem ci ON ci.ROWID = a.owner_id\n        WHERE lower(ci.UUID) = lower(?1)\n          AND lower(af.UUID) = lower(?2)\n        ",
