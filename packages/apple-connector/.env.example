# Offline SQLx compile (also set in .cargo/config.toml and nix develop)
SQLX_OFFLINE=true
SQLX_OFFLINE_DIR=packages/apple-connector/sqlx

# Messages fixture (default for single-schema prepare)
DATABASE_URL=sqlite:packages/apple-connector/fixtures/messages/chat.db

# Per-domain fixture URLs used by scripts/sqlx-prepare-all.sh:
# DATABASE_URL=sqlite:packages/apple-connector/fixtures/reminders/reminders.db
# DATABASE_URL=sqlite:packages/apple-connector/fixtures/notes/notes.db
# DATABASE_URL=sqlite:packages/apple-connector/fixtures/calendar/calendar.db
# DATABASE_URL=sqlite:packages/apple-connector/fixtures/contacts/contacts.abcddb
