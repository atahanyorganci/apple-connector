{
	"$schema": "https://www.raycast.com/schemas/extension.json",
	"name": "apple-connector",
	"description": "Connect Apple native apps to Raycast.",
	"categories": [
		"Productivity"
	],
	"license": "MIT",
	"author": "atahanyorganci",
	"scripts": {
		"build": "ray build",
		"dev": "ray develop",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"generate": "node scripts/generate-api-client.mjs",
		"generate:check": "node scripts/generate-api-client.mjs --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@raycast/api": "^1.104.20",
		"@raycast/utils": "^2.2.7"
	},
	"devDependencies": {
		"@types/node": "22.19.17",
		"@types/react": "19.0.10",
		"typescript": "^7.0.2"
	},
	"icon": "extension-icon.png",
	"commands": [
		{
			"name": "create-reminder",
			"title": "Create reminder",
			"subtitle": "",
			"description": "Create a new reminder in Reminders app.",
			"mode": "no-view"
		}
	],
	"platforms": [
		"macOS"
	],
	"title": "Apple Connector",
	"tools": []
}
